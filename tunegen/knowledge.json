  "rules": [
    {"id": "R_HOT", "when": {"all": [{"metric": "air_temp_c", "op": ">=", "value": 35}]},
     "then": {"max_aggressiveness": 0.40, "part_multipliers": {"heat_sensitive": 0.60, "aggressive_timing": 0.50},
              "advice": "Intake air is very hot: airflow gains shrink and knock risk rises. Aggressive ECU tunes are excluded."}},
    {"id": "R_WET", "when": {"any": [{"metric": "is_raining", "op": ">=", "value": 1}, {"metric": "precip_mm", "op": ">=", "value": 1.0}, {"metric": "humidity_pct", "op": ">=", "value": 90}]},
     "then": {"avoid_tags": ["water_ingestion_risk"],
              "advice": "Rain or waterlogging: open element intakes risk water ingestion and are removed from the plan."}},
    {"id": "R_THIN_AIR", "when": {"all": [{"metric": "density_ratio", "op": "<=", "value": 0.85}]},
     "then": {"max_aggressiveness": 0.55, "part_multipliers": {"airflow": 0.80, "aggressive_timing": 1.10},
              "advice": "Thin air (altitude or heat): a naturally aspirated engine loses power, bolt on airflow parts help less, ECU corrections help more."}},
    {"id": "R_IDEAL", "when": {"all": [{"metric": "air_temp_c", "op": "<=", "value": 24}, {"metric": "is_raining", "op": "<", "value": 1}, {"metric": "precip_mm", "op": "<", "value": 0.1}, {"metric": "density_ratio", "op": ">=", "value": 0.88}]},
     "then": {"max_aggressiveness": 0.85, "part_multipliers": {"airflow": 1.15},
              "advice": "Cool, dry, dense air: airflow parts deliver close to their full claimed gain."}}
  ]
